{
  "name": "Match Week Food Diary",
  "short_name": "Food Diary",
  "description": "A lightweight food and exercise diary tracked in Monday-to-Monday match weeks.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f6f3",
  "theme_color": "#1f9d52",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Log food",
      "short_name": "Log",
      "url": "/?action=log",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Scan a barcode",
      "short_name": "Scan",
      "url": "/?action=scan",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Weigh in",
      "short_name": "Weigh in",
      "url": "/?action=weigh",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
