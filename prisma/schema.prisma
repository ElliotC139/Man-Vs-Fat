generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One account per person using the diary. Each has their own week-start
// (weekday + time) so e.g. one user's week can run Mon 17:00 -> Mon 17:00
// while another's runs Wed 09:00 -> Wed 09:00.
model User {
  id                 Int                  @id @default(autoincrement())
  username           String               @unique
  // Null for accounts created via "Sign in with Google" that never set a password.
  passwordHash       String?
  // Set once an account is created or signed into via Google.
  googleId           String?              @unique
  email              String?              @unique
  // 0 = Monday .. 6 = Sunday, matching WEEKDAYS_MON_FIRST in matchWeek.ts.
  weekStartWeekday   Int                  @default(0)
  weekStartHour      Int                  @default(17)
  weekStartMinute    Int                  @default(0)
  // Body stats and goal for calorie budget calculation.
  weightKg           Float?
  heightCm           Float?
  ageYears           Int?
  // "male" | "female" | null. Mifflin-St Jeor needs it: the constant is +5 for
  // men and -161 for women, a 166 kcal/day difference. Optional — nobody is
  // forced to answer; see estimateTdee for what an unset value falls back to.
  sex                String?
  // Which cards each screen shows and in what order, as JSON:
  // { "today": { "order": ["today:hero", ...], "hidden": [...] } }. Stored as
  // a string because SQLite has no JSON column, and shaped as order-plus-hidden
  // rather than a list of what's on so a card added in a later version still
  // appears for someone who arranged their layout before it existed.
  layout             String?
  // Which figure the Today card treats as the day's burn: "measured" from a
  // connected tracker, "target" the daily calorie target below, or "estimate"
  // the Mifflin-St Jeor figure from height, weight, age and activity. Null
  // means measured, which is what the card did before this was a choice — and
  // whichever is picked, the caption on the card says which one it is rather
  // than calling a whole-day figure "burned so far".
  burnSource         String?
  // Meal tags: whether the log form asks which meal an entry belongs to, and
  // what those four slots are called. Off by default — the diary has always
  // inferred a meal from the clock and most people never want to think about
  // it, so this is opt-in rather than another field in the way.
  //
  // The names are labels only. The stored values on an entry stay the four in
  // MEAL_TYPES, so renaming "snack" to "supper" re-labels the back catalogue
  // instead of orphaning it, and turning the feature off leaves every entry
  // exactly where it was.
  mealTagsEnabled    Boolean              @default(false)
  // JSON: {"breakfast":"...","lunch":"...","dinner":"...","snack":"..."}.
  // Null, or any missing key, falls back to the built-in name.
  mealTagNames       String?
  activityLevel      String?
  weeklyGoalKg       Float?
  // Target weight. weeklyGoalKg is the desired *rate*; this is the
  // destination, which is what makes a projected arrival date possible.
  goalWeightKg       Float?
  // A kcal figure the user has chosen to aim at. Deliberately separate from
  // the derived budget: the app can work one out from body stats or WHOOP,
  // but "what am I aiming at today" should be a number the user owns and can
  // override, not one that silently moves when a wearable syncs.
  dailyCalorieTarget Int?
  // Macro targets. Null macroMode means macros are off entirely and the app
  // behaves exactly as it did before they existed — the diary shows calories
  // and nothing else.
  //
  // Two modes, because the two ways people think about macros don't convert
  // cleanly into one stored form:
  //   "grams"   — the target IS the gram figure, fixed whatever the calorie
  //               target does. Someone on "180g of protein, full stop" means
  //               180g even on a big training day. Each macro also carries
  //               its own comparison (see proteinOp below), because the three
  //               are rarely wanted the same way round: protein is usually a
  //               floor, carbs or fat a ceiling.
  //   "percent" — the target is a share of the calorie target, so raising
  //               that raises every macro with it. Storing the derived grams
  //               instead would silently go stale the moment the calorie
  //               target changed, which is why both sets of columns exist
  //               rather than one "value" column plus a unit flag.
  // See resolveMacroTargets() in src/macros.ts, which is the only thing that
  // should read these.
  macroMode          String?
  // Null (or 0) means that macro simply isn't tracked, and it's left off the
  // diary entirely rather than shown against a target of nothing.
  proteinTargetG     Int?
  carbsTargetG       Int?
  fatTargetG         Int?
  // How to read the gram figure above: "min" (at least), "max" (at most) or
  // "eq" (about). Null reads as "eq", which is what every target set before
  // this column existed meant. Only used in grams mode — percentages have to
  // sum to 100, so they're always "eq".
  proteinOp          String?
  carbsOp            String?
  fatOp              String?
  proteinPct         Int?
  carbsPct           Int?
  fatPct             Int?
  // Every session token issued before this instant is rejected (see
  // src/auth.ts). Setting it to now is what "sign out everywhere" does —
  // it revokes stateless tokens without needing a session table.
  sessionsValidFrom  DateTime?
  // Local hour (0-23) to send the "you haven't logged today" nudge, or null
  // for no reminder at all. Off by default: an app that starts nagging
  // without being asked gets its notifications turned off for good.
  reminderHour       Int?
  createdAt          DateTime             @default(now())
  matchWeeks         MatchWeek[]
  whoopConnection    WhoopConnection?
  whoopCycles        WhoopCycle[]
  whoopSleeps        WhoopSleep[]
  whoopRecoveries    WhoopRecovery[]
  foodFavorites      FoodFavorite[]
  foodOverrides      FoodOverride[]
  foodTags           FoodTag[]
  weighIns           WeighIn[]
  savedMeals         SavedMeal[]
  pushSubscriptions  PushSubscription[]
  passwordResets     PasswordResetToken[]
  measurements       Measurement[]
  progressPhotos     ProgressPhoto[]
  dayNotes           DayNote[]
  waterLogs          WaterLog[]
}

// A single-use token for resetting a forgotten password. Only the hash is
// stored, so a leaked database still doesn't hand anyone a working reset
// link — the same reason passwordHash exists rather than the password.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tape measurements for one calendar day. Weight alone stalls for weeks at a
// time on a training programme; waist keeps moving, which is why it's the
// one measurement that's always shown and the rest are optional.
model Measurement {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      String
  waistCm   Float?
  chestCm   Float?
  hipsCm    Float?
  thighCm   Float?
  armCm     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// A progress photo, kept apart from Entry.imageUrl: a food photo belongs to
// one meal in one week, whereas these are the series you look back through,
// so they're keyed by day and never swept up by entry deletion.
model ProgressPhoto {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      String
  imageUrl  String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Free text about a day — "food poisoning", "stag do", "first week back
// running". Fed to the weekly review so it can explain an odd week instead
// of guessing at it.
model DayNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// One running millilitre total per calendar day rather than a row per glass:
// nobody wants to scroll a list of eight identical 250ml entries, and the
// only question ever asked of this data is "how much today".
model WaterLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      String
  ml        Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// Server-side errors, kept in the database so a failure that happens at 3am
// is still visible at 9am. stdout on Fly rolls away; this doesn't, and it's
// what the Diagnostics panel in Settings reads.
model AppError {
  id        Int      @id @default(autoincrement())
  // Where it happened — "whoop.sync", "estimate", "request", etc.
  context   String
  message   String
  stack     String?
  // Null for failures with no signed-in user (a cron job, an auth attempt).
  userId    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A starred food, keyed by the entry label normalized (trimmed, lowercased)
// so it groups every logging of "the same" food regardless of exact
// capitalization — see src/routes/foods.ts for how the food library page
// aggregates Entry rows by this same key.
model FoodFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  labelKey  String
  createdAt DateTime @default(now())

  @@unique([userId, labelKey])
}

// Corrected figures for a food, keyed the same way as FoodFavorite above.
// A "food" is not a row anywhere — it is every Entry sharing a normalized
// label, so there is nothing to edit directly. This holds what the food
// *should* be, and both the library and one-tap logging read through it.
// Past entries are deliberately left alone: correcting what gets logged from
// here on is the ask; silently rewriting last month's diary is not.
model FoodOverride {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  labelKey  String
  label     String
  kcal      Int?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  updatedAt DateTime @updatedAt

  @@unique([userId, labelKey])
}

// A tag attached to a food (same labelKey grouping as FoodFavorite above).
model FoodTag {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  labelKey  String
  tag       String
  createdAt DateTime @default(now())

  @@unique([userId, labelKey, tag])
  @@index([userId, labelKey])
}

// One WHOOP OAuth link per user. accessToken/expiresAt are refreshed in place
// as needed (see src/whoop/sync.ts); refreshToken only changes if WHOOP
// rotates it on refresh.
model WhoopConnection {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id])
  // WHOOP's own numeric user id, captured from the first synced cycle's
  // user_id field (not requested via a dedicated profile scope) — lets the
  // webhook, which is keyed by WHOOP user id, resolve back to our userId.
  whoopUserId      BigInt?
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  lastSyncedAt     DateTime?
  // Set once a wider one-time historical sync has pulled cycles/workouts/
  // sleep/recovery as far back as DEEP_BACKFILL_DAYS (see src/whoop/sync.ts)
  // instead of the normal short trailing window — null means that hasn't
  // run yet, including for connections that predate this field.
  deepBackfilledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// A WHOOP physiological cycle (roughly one per day, wake-to-wake), used as
// the measured total daily calorie burn feeding the budget widget.
model WhoopCycle {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  whoopCycleId BigInt    @unique
  start        DateTime
  end          DateTime?
  // Null until WHOOP finalizes ("SCORED") the cycle — see scoreState.
  kcalBurned   Int?
  scoreState   String
  updatedAt    DateTime  @updatedAt

  @@index([userId, start])
}

// A WHOOP sleep (one per night, occasionally a nap). Sleep ids are UUID
// strings like workout ids, not numeric like cycle ids.
model WhoopSleep {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  whoopSleepId       String   @unique
  start              DateTime
  end                DateTime
  // Null until WHOOP finalizes ("SCORED") the sleep — see scoreState.
  performancePercent Int?
  timeAsleepMin      Int?
  scoreState         String
  updatedAt          DateTime @updatedAt

  @@index([userId, start])
}

// A WHOOP recovery — one per cycle, scored from the following sleep's HRV
// and resting heart rate. Keyed by the cycle it belongs to, same as
// WhoopCycle.whoopCycleId, since WHOOP relates recovery to a cycle 1:1.
model WhoopRecovery {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  whoopCycleId     BigInt   @unique
  // Local calendar day this recovery applies to (see localDayKey in
  // matchWeek.ts) — lets the Stats screen look up "today's" recovery
  // without re-deriving it from the cycle's start/end each time.
  date             String
  // Null until WHOOP finalizes ("SCORED") the recovery — see scoreState.
  recoveryScore    Int?
  restingHeartRate Int?
  hrvMilli         Float?
  scoreState       String
  updatedAt        DateTime @updatedAt

  @@index([userId, date])
}

// A single week-start -> following week-start boundary, per user. First-class
// so reports, averages and the PDF all key off the same definition of "week".
// userId is nullable only to let pre-multi-user rows exist; the first-ever
// signup claims them (see routes/auth.ts).
model MatchWeek {
  id                Int        @id @default(autoincrement())
  userId            Int?
  user              User?      @relation(fields: [userId], references: [id])
  startsAt          DateTime
  endsAt            DateTime
  reportGeneratedAt DateTime?
  reportDriveFileId String?
  reportDriveUrl    String?
  // The AI end-of-week review, as the JSON that src/insights.ts produces.
  // Cached here because generating it costs a model call: the in-app review
  // and the PDF are the same four sections, and re-deriving them on every
  // view would bill for the same paragraphs repeatedly.
  insightsJson      String?
  // When the cached review was generated, so a week still being logged can
  // have a stale review refreshed rather than being stuck with the version
  // written after its first two entries.
  insightsAt        DateTime?
  entries           Entry[]
  exercises         Exercise[]

  @@unique([userId, startsAt, endsAt])
}

model Exercise {
  id             Int       @id @default(autoincrement())
  timestamp      DateTime  @default(now())
  description    String
  kcalBurned     Int?
  imageUrl       String?
  matchWeekId    Int
  matchWeek      MatchWeek @relation(fields: [matchWeekId], references: [id])
  createdAt      DateTime  @default(now())
  // Set only for entries auto-imported from a WHOOP workout, so resyncing
  // can upsert by this id instead of creating duplicates each time.
  // UUID string — WHOOP workout ids aren't numeric, unlike cycle ids.
  whoopWorkoutId String?   @unique

  @@index([matchWeekId])
}

model Entry {
  id          Int       @id @default(autoincrement())
  timestamp   DateTime  @default(now())
  rawInput    String?
  label       String
  // Nullable: estimation can fail (e.g. unparsable model response); the
  // entry is still kept so nothing logged is silently lost, and the user
  // can fill the number in by hand.
  kcal        Int?
  imageUrl    String?
  // Breakfast / lunch / dinner / snack — defaulted from local time-of-day at
  // creation (see inferMealType), editable afterwards via PATCH.
  mealType    String    @default("snack")
  // Where the kcal figure came from, so the diary can be honest about how
  // much to trust it: "ai" (estimated from text/photo), "database" (a real
  // per-100g figure from Open Food Facts), "manual" (the user typed the
  // number), "meal" (copied from a saved meal or recipe). Defaults to "ai"
  // because every row that predates this column was AI-estimated.
  source      String    @default("ai")
  edited      Boolean   @default(false)
  // How many of this item were eaten. kcal is always the *total* for the
  // whole entry, not one unit — so the diary keeps summing straight whether
  // or not anything ever sets a quantity, and changing it here rescales kcal
  // and the macros below proportionally (see routes/entries.ts).
  quantity    Float     @default(1)
  // Grams for the whole entry, same convention as kcal. Null means "not
  // known" rather than zero, which matters: every entry logged before macros
  // existed has null here, and a day containing one of those can't honestly
  // claim a complete macro total — the diary says so rather than quietly
  // under-counting.
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  matchWeekId Int
  matchWeek   MatchWeek @relation(fields: [matchWeekId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([matchWeekId])
}

// A browser push endpoint the user has granted this app. One row per
// browser/device, not per user — the same account signed in on a phone and a
// laptop is two subscriptions, and both should get the reminder.
//
// endpoint is the natural key: the browser regenerates it when a
// subscription is replaced, so an upsert on it keeps this table from filling
// with dead endpoints for the same device.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  // The two keys from the browser's PushSubscription, needed to encrypt a
  // payload that only that browser can read.
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// A named set of foods the user logs together. Two shapes share this table
// because they differ only in how a portion is derived:
//
//   kind = "template" — foods eaten together on one occasion ("my usual
//     breakfast"). Logging it writes one Entry per item, so any single item
//     can still be edited or deleted afterwards.
//   kind = "recipe" — a batch cooked once and eaten over several sittings
//     (a tray of chilli). `servings` says how many portions the item list
//     makes; logging it writes one Entry for the portion actually eaten.
model SavedMeal {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  name      String
  kind      String          @default("template")
  // Always 1 for a template. For a recipe this is what divides the item
  // total to give one portion, so it must never be zero.
  servings  Float           @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     SavedMealItem[]

  @@unique([userId, name])
  @@index([userId])
}

// One food within a SavedMeal. Deliberately a plain label/kcal pair rather
// than a link to Entry or the food library: a saved meal should keep working
// unchanged after the entries it was built from are edited or deleted.
model SavedMealItem {
  id          Int       @id @default(autoincrement())
  savedMealId Int
  savedMeal   SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  label       String
  kcal        Int?
  // Carried through to the Entry rows this item creates, so a saved meal
  // logged in two taps is as complete as one typed out in full.
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  sortOrder   Int       @default(0)

  @@index([savedMealId])
}

// A single weigh-in for a calendar day. date is a local "YYYY-MM-DD" key
// (see localDayKey in matchWeek.ts) rather than a DateTime — a weigh-in is
// inherently one value per calendar day, and the unique constraint below
// lets logging a weight for a date that already has one just overwrite it.
model WeighIn {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      String
  weightKg  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// Small persistent key/value store for things like the cached Drive folder id.
model Setting {
  key   String @id
  value String
}
