# --- Core ---
PORT=3000
# IANA timezone the match week boundary (Mon 17:00 -> Mon 17:00) is anchored to.
TIMEZONE=Europe/London
# Note: relative to prisma/schema.prisma, not the repo root, so this
# resolves to <repo-root>/data/dev.db (same place uploads/reports live).
DATABASE_URL="file:../data/dev.db"

# --- Claude API (vision-capable model) ---
ANTHROPIC_API_KEY=
# Any current vision-capable Claude model id. Override as new models ship.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Google Drive upload ---
# OAuth client from a Google Cloud project (type: TVs and Limited Input devices).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in by `npm run google:auth` after the one-time consent flow.
GOOGLE_REFRESH_TOKEN=
# Optional: reuse a specific Drive folder instead of auto-creating "Food Diary".
GOOGLE_DRIVE_FOLDER_ID=

# --- Sign in with Google (optional) ---
# A *different* OAuth client from the Drive one above (type: Web application),
# with this app's URL added under "Authorized JavaScript origins". Leave unset
# to hide the "Sign in with Google" button — username/password still works.
GOOGLE_SIGNIN_CLIENT_ID=

# --- Password reset by email (optional) ---
# A Resend API key. With it, "Forgotten your password?" emails a one-hour
# reset link. Without it, the only way back into a locked-out account is
# signing in with a linked Google account, and the app says so rather than
# pretending an email is on its way.
RESEND_API_KEY=
# The From: address. Must be on a domain verified with Resend, or delivery
# is rejected.
MAIL_FROM=Food Diary <onboarding@resend.dev>

# --- Error alerting (optional) ---
# A Slack-style incoming webhook. Every recorded server error is POSTed to it
# as {"text": "..."}. Errors are stored and shown in Settings > Diagnostics
# either way; this is what makes them reach you without looking.
ERROR_WEBHOOK_URL=

# --- Food search (both optional) ---
# Food search always covers the user's own diary and Open Food Facts. These two
# keys widen it, and each one is independent — an unset or wrong key is one
# source quietly missing from the results, never a failed search.
#
# Nutritionix is what puts restaurant and pub menus into search, plus the
# everyday foods that never came in a packet. Open Food Facts is packaged
# groceries only, so without this nothing off a menu is findable.
# Free developer keys: https://developer.nutritionix.com
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# USDA FoodData Central adds plain ingredients, already stated per 100g — the
# chicken breasts and jacket potatoes a database of packets doesn't have.
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
